{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "space-ddf-archive",
  "main": "src/index.js",
  "compatibility_date": "2026-06-14",
  "triggers": {
    "crons": ["0 18 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "space-ddf-archive",
      "database_id": "<CLOUDFLARE_D1_DATABASE_ID>",
      "migrations_dir": "migrations"
    }
  ]
}
