{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vite --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run assets:manifest && vite build && npm run prerender && npm run csp:hashes && npm run package:dist",
    "assets:manifest": "node scripts/write-content-assets-manifest.js",
    "prerender": "node scripts/prerender-seo.js",
    "csp:hashes": "node scripts/apply-csp-hashes.js",
    "package:dist": "node scripts/package-dist.js",
    "package:originals": "node scripts/package-originals.js",
    "preview": "vite preview --host 127.0.0.1",
    "smoke": "node scripts/smoke-test.js",
    "test:crawler": "node --test cloudflare/test/*.test.js",
    "lint": "eslint . --ext .vue,.js"
  },
  "dependencies": {
    "pinia": "^3.0.3",
    "vue": "^3.5.34",
    "vue-easy-lightbox": "^1.19.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "vite": "^8.0.16"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "browser": true,
      "es2021": true,
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser",
      "requireConfigFile": false
    },
    "globals": {
      "defineProps": "readonly",
      "defineEmits": "readonly",
      "defineExpose": "readonly",
      "withDefaults": "readonly"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
